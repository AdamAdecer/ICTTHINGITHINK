    <section id="contact">
        <div class="form-container">
            <form>
                <label for="name">Your Name:</label>
                <input type="text" id="name" name="name" placeholder="John Pork">
                <br>
                <label for="email">Your Email:</label>
                <input type="email" id="email" name="email" placeholder="john.gta6.pork@bmail.com">
                <br>


                <label>How did you find me?</label>
                <div class="radio-group">
                    <input type="radio" id="r1" name="r-selection" value="1" required>
                    <label for="r1">Facebook</label>


                    <input type="radio" id="r2" name="r-selection" value="2" required>
                    <label for="r2">Youtube</label>


                    <input type="radio" id="r3" name="r-selection" value="3" required>
                    <label for="r3">Discord</label>
                    
                </div>


                <br>


                <label>Interested in:</label>
                <div class="checkbox-group">
                    <input type="checkbox" id="ch1" name="interests" value="checkbox1">
                    <label for="ch1">Web Design</label>


                    <input type="checkbox" id="ch2" name="interests" value="checkbox2">
                    <label for="ch2">Devlogs</label>


                    <input type="checkbox" id="ch3" name="interests" value="checkbox3">
                    <label for="ch3">Game Development</label>
                </div>


                <br>


                <label for="selection">Rate My Page Pls :3</label>
                <select id="selection" name="selection" required>
                    <option value="">--Select Rating--</option>
                    <option value="1">⭐️</option>
                    <option value="2">⭐️⭐️</option>
                    <option value="3">⭐️⭐️⭐️</option>
                    <option value="4">⭐️⭐️⭐️⭐️</option>
                    <option value="5">⭐️⭐️⭐️⭐️⭐️</option>
                    <option value="FURRYDETECTED">UwU</option>
                </select>


                <br>


                <label for="feedback">Any Feedback?</label>
                <textarea id="feedback" name="feedback" rows="4" placeholder="write your feedback here..." required></textarea>


                <br>


                <button type="submit">Submit</button>
            </form>


        </div>
    </section>


    <footer>
        <p>© 2026 Adesir "Damdam" Mortualdez Adamos Jr., 9-Emerald. All rights reserved and enforced via gulag</p>
